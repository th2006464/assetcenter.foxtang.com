{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ams",
  "account_id": "2bb272d5a3b5b6ce1bdfba1db760c87c",
  "main": "ams.js",
  "compatibility_date": "2026-07-23",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "teams-9dr-pages.cloudflareaccess.com",
    "ACCESS_AUD": "12809129156e3b926bf1e5280234d459720d84027d06a9033580fbdb498ce1f4"
  },
  "routes": [
    {
      "pattern": "ams.foxtang.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ams",
      "database_id": "01737c5b-7a1d-4446-b384-06506bae195a"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
